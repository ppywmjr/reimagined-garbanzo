#!/usr/bin/env bash
# Keeps .agents/skills/repo-orientation/SKILL.md in sync with the repo.
# Runs after every commit; fully non-blocking (a failure here never breaks your commit).
# Enable once per clone with: git config core.hooksPath git-hooks
set -u
cd "$(git rev-parse --show-toplevel)" || exit 0

SKILL=".agents/skills/repo-orientation/SKILL.md"
[ -f "$SKILL" ] || exit 0
[ -f "scripts/update-orientation.mjs" ] || exit 0
command -v node >/dev/null 2>&1 || exit 0

if ! ORIENTATION_HOOK=1 node scripts/update-orientation.mjs; then
  echo "⚠️ repo-orientation: refresh failed (ignored, commit still stands)"
  exit 0
fi

if [ -n "$(git status --porcelain -- "$SKILL")" ]; then
  git add "$SKILL"
  if git commit -q -m "chore(orientation): refresh generated sections" -- "$SKILL"; then
    echo "✓ repo-orientation: refreshed and auto-committed"
  else
    echo "⚠️ repo-orientation: refreshed, but auto-commit failed (left staged)"
  fi
fi
exit 0
